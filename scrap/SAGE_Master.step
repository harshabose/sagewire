#401959=PRODUCT('HW_Kit_SparFitting_Inner_Main',
'HW_Kit_SparFitting_Inner_Main v1',
'Fasteners for the inner (FRAME_Side) main-spar clamp collar: 4x M4x16
 SHCS + M4 nylocs through flange and frame, 1x M5x55 cross-bolt + M5 n
yloc through sleeve and spar. Origin = spar axis on the frame outboard
 face, +Y = collar side.',(#401953));
#401960=PRODUCT('HW_Kit_SparFitting_Inner_Aux',
'HW_Kit_SparFitting_Inner_Aux v1',
'Fasteners for the inner (FRAME_Side) aux-spar clamp collar: 4x M3x14 
SHCS + M3 nylocs, 1x M4x35 cross-bolt + M4 nyloc. Origin = spar axis o
n the frame outboard face, +Y = collar side.',(#401953));
#401961=PRODUCT('HW_Kit_SparFitting_Outer_Main',
'HW_Kit_SparFitting_Outer_Main v1',
'Fasteners for the outer (FRAME_SideOuter) main-spar sleeve plate: 3x 
M4x16 SHCS + M4 nylocs. Origin = spar axis on the frame inboard face, 
-Y = fitting side.',(#401953));
#401962=PRODUCT('HW_Kit_SparFitting_Outer_Aux',
'HW_Kit_SparFitting_Outer_Aux v1',
'Fasteners for the outer (FRAME_SideOuter) aux-spar sleeve plate: 2x M
3x14 SHCS + M3 nylocs. Origin = spar axis on the frame inboard face, -
Y = fitting side.',(#401953));
